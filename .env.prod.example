# ─── ONI Cortex — Production Environment Variables ───────────────────
# Copy to .env.prod and fill in real values before deploying.

# ── Domain & TLS ─────────────────────────────────────────────────────
CORTEX_DOMAIN=cortex.oni.dev

# ── PostgreSQL ───────────────────────────────────────────────────────
PG_USER=cortex
PG_PASS=CHANGE_ME_STRONG_PASSWORD
PG_DB=cortex

# ── JWT / Auth ───────────────────────────────────────────────────────
CORTEX_JWT_SECRET=CHANGE_ME_RANDOM_HEX_64

# ── Stripe Billing ───────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_TEAM=price_...
STRIPE_PRICE_BUSINESS=price_...

# ── MCP / Indexer Settings ───────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_PROVIDER=fastembed
COLLECTION_NAME=codebase
REFRAG_DECODER=0
USE_GPU_DECODER=0

# ── Upload Service ───────────────────────────────────────────────────
MAX_BUNDLE_SIZE_MB=100
UPLOAD_TIMEOUT_SECS=300
